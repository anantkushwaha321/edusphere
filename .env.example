# ==============================================================================
# IIMT UNIVERSITY — Smart Academic Management System
# Production & Local Environment Variables Configuration Template
# ==============================================================================

# Core Django Security
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com,https://*.railway.app

# Database Options:
# Option 1: Direct Cloud Database URL (Render / Railway / Heroku / AWS)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Individual Connection Variables (PostgreSQL)
DB_ENGINE=sqlite
DB_NAME=iimt_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ==============================================================================
# Real Email / SMTP Delivery Service
# ==============================================================================
# To deliver OTPs directly to user email addresses over the internet:
# For Gmail:
#   1. Enable 2-Step Verification on your Google Account
#   2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
#   3. Fill EMAIL_HOST_USER and EMAIL_HOST_PASSWORD below.
# ==============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=IIMT UNIVERSITY Security <your_email@gmail.com>
