# ==============================================================================
# IIMT UNIVERSITY — Smart Academic Management System
# Production & Local Environment Variables Configuration Template
# ==============================================================================

# Core Django Security
DJANGO_SECRET_KEY=generate-a-strong-random-secret-key-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com,https://*.railway.app

# Database Options:
# Option 1: Direct Cloud Database URL (Render / Railway / Heroku / AWS)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option 2: Individual Connection Variables (PostgreSQL)
DB_ENGINE=sqlite
DB_NAME=iimt_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Email / SMTP Delivery Service
# For local dev, use console backend (prints OTPs to terminal)
# For production, set to django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=IIMT UNIVERSITY Security <no-reply@iimtindia.net>
